# CareerPilot AI - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================
# LLM Provider Configuration
# ============================================================

# Primary: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Secondary: xAI Grok (Responses API; requests are sent with server-side storage disabled)
XAI_API_KEY=
GROK_MODEL=grok-4.7

# Optional third provider: Groq-hosted open-weight models (not xAI Grok)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Provider order; deterministic local fallback is used if all providers fail
LLM_PROVIDER_PRIORITY=gemini,xai,groq

# ============================================================
# Search Configuration
# ============================================================

# SearXNG instance URL (self-hosted metasearch)
SEARXNG_URL=http://localhost:8888
SEARXNG_ENABLED=false

# ============================================================
# Database
# ============================================================
DATABASE_URL=sqlite+aiosqlite:///./data/careerpilot.db

# ============================================================
# Application
# ============================================================
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# Security
# ============================================================
SECRET_KEY=change-this-in-production
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_TYPES=.pdf,.docx,.txt

# ============================================================
# MCP Server
# ============================================================
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
